NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://shortener:local_dev_password@localhost:5432/url_shortener
DB_POOL_MAX=10
# Required: replace with a random secret of at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY=
# Comma-separated browser origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=
# Set only for a known proxy topology; 0 means a direct connection.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT=60
REDIRECT_RATE_LIMIT=300
LOG_LEVEL=info

# Shared Redis is required when NODE_ENV=production. Empty enables local development mode.
REDIS_URL=
REDIS_PREFIX=shortener
REDIS_TIMEOUT_MS=500
CACHE_TTL_SECONDS=60
DB_QUERY_TIMEOUT_MS=2000
MAX_INFLIGHT_REQUESTS=500
# Prefer metrics over one log line per redirect.
HTTP_LOG_ENABLED=false

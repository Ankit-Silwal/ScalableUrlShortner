{
  "name": "scalable-url-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "Layered Node.js and PostgreSQL URL shortener API",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "test:postgres:local": "node scripts/test-postgres-local.js"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  }
}
